#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

usage() {
  cat <<'EOF'
ExitPanel VPS 管理工具
用法：sudo exitpanel [--dir /opt/exitpanel] <命令>

  credentials      显示数据库中当前管理 URL 和可恢复的管理员密码
  reset-password  随机生成新管理员密码，并作废旧登录会话
  bootstrap       幂等初始化数据库管理设置，不覆盖已有设置
  --help, -h      显示帮助（无需 root）

安装目录默认从 /etc/exitpanel/install-dir 读取，否则为 /opt/exitpanel。
可用 EXITPANEL_INSTALL_DIR 或 --dir 覆盖。请勿将凭据输出发送给他人。
EOF
}

for arg in "$@"; do
  case "$arg" in --help|-h) usage; exit 0 ;; esac
done
[[ "$(id -u)" == "0" ]] || { echo '此工具仅允许 root 使用，请执行 sudo exitpanel ...' >&2; exit 1; }

INSTALL_DIR="${EXITPANEL_INSTALL_DIR:-}"
if [[ -z "$INSTALL_DIR" && -f /etc/exitpanel/install-dir ]]; then
  IFS= read -r INSTALL_DIR </etc/exitpanel/install-dir
fi
INSTALL_DIR="${INSTALL_DIR:-/opt/exitpanel}"
if [[ "${1:-}" == --dir ]]; then
  [[ $# -ge 3 && -n "$2" ]] || { usage >&2; exit 1; }
  INSTALL_DIR="$2"
  shift 2
fi
[[ $# == 1 ]] || { usage >&2; exit 1; }
case "$1" in
  credentials|reset-password|bootstrap) ;;
  *) echo "未知命令：$1" >&2; usage >&2; exit 1 ;;
esac
[[ "$INSTALL_DIR" == /* && -d "$INSTALL_DIR" ]] || { echo '安装目录不存在或不是绝对路径。' >&2; exit 1; }
[[ -f "$INSTALL_DIR/.env.production" && -f "$INSTALL_DIR/docker-compose.prod.yml" ]] || {
  echo "未找到 ExitPanel 生产配置：$INSTALL_DIR" >&2; exit 1;
}
command -v docker >/dev/null || { echo '未安装 Docker。' >&2; exit 1; }
cd "$INSTALL_DIR"
CONTAINER_ID="$(docker compose --env-file .env.production -f docker-compose.prod.yml ps -q app)"
[[ -n "$CONTAINER_ID" && "$CONTAINER_ID" != *$'\n'* ]] || {
  echo 'app 容器未运行；请先启动 exitpanel-compose 服务并检查应用日志。' >&2; exit 1;
}
# Never source .env.production or show its contents. The container already has
# the production environment; adminCli reads the authoritative DB settings.
exec docker exec "$CONTAINER_ID" node dist/adminCli.js "$1"
